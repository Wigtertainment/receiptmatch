{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "validation": {
      "projectType": "application",
      "root": "",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/ui.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": ".build/ui",
            "baseHref": "./",
            "optimization": true,
            "sourceMap": false
          }
        }
      }
    }
  }
}
