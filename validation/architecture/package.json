    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@electron/packager": "20.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "45.2.3",
    "esbuild": "0.25.12",
    "pdfjs-dist": "6.5.438",
    "rxjs": "7.8.2",
    "tesseract.js": "7.0.0",
