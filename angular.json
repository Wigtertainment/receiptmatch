{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "receiptmatch": {
      "projectType": "application",
      "root": "",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/app.ts",
            "index": "src/index.html",
            "styles": ["@wigtertainment-ltd/comp-lib/styles/default.css", "src/styles.css"],
            "tsConfig": "tsconfig.app.json",
            "outputPath": ".build/ui",
            "baseHref": "./",
            "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
            "sourceMap": false
          },
          "configurations": {
            "production": {},
            "development": { "optimization": false, "sourceMap": { "scripts": false, "styles": true } }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "receiptmatch:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "receiptmatch-preview": {
      "projectType": "application",
      "root": "electron/preview",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "electron/preview/renderer.ts",
            "index": "electron/preview/index.html",
            "styles": ["@wigtertainment-ltd/comp-lib/styles/default.css", "electron/preview/viewer.css"],
            "tsConfig": "tsconfig.preview.json",
            "outputPath": ".build/preview",
            "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
            "sourceMap": false
          }
        }
      }
    }
  }
}
