{
  "name": "receiptmatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first financial reconciliation desktop application",
  "main": ".build/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "start": "node scripts/start.mjs",
    "test:unit": "node --test .build/node/tests/unit/*.test.js",
    "test:packaged": "node tests/packaged.mjs",
    "test": "npm run test:unit && npm run test:packaged"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@electron/packager": "20.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "electron": "45.2.3",
    "esbuild": "0.25.12",
    "playwright": "1.65.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
